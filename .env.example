# Copy to .env and fill with real values. NEVER commit the real .env.
# See .gitignore: .env is excluded from version control.

# --- Champi chat ---
# API key from https://opencode.ai/zen (subscribe to Go / Go Plus)
OPENCODE_GO_API_KEY=your-opencode-go-api-key

# Password to access chat.eduardovilla.com
APP_PASSWORD=change-me

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Model used for new conversations
DEFAULT_MODEL=deepseek-v4.1-flash

# OpenCode Go API base URL (Go plan) — do not change unless the endpoint changes
GO_BASE_URL=https://opencode.ai/zen/go/v1

# Value sent as User-Agent; must identify this client per OpenCode Go usage policy
GO_USER_AGENT=eduardo-chat/1.0

# Server port (inside the container)
PORT=3000
DATA_DIR=/data

# Set to false only when serving over plain HTTP (local dev) so the session
# cookie is not marked Secure.
# COOKIE_SECURE=false
